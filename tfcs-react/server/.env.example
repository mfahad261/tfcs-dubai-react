# Copy this file to server/.env and fill in SMTP_PASS. Never commit server/.env.

PORT=5000

# Main domain without www. Visitors on www are redirected here.
CANONICAL_HOST=tfcstechnicalandcleaningservices.com

# Hostinger mail server. Port 465 uses SSL, so SMTP_SECURE stays true.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# The mailbox that logs in and sends the emails
SMTP_USER=info@tfcstechnicalandcleaningservices.com

# Your Hostinger mailbox password. Keep the double quotes.
SMTP_PASS=""

# Who receives the notifications, and the name shown as the sender
MAIL_TO=info@tfcstechnicalandcleaningservices.com
MAIL_FROM_NAME=TFCS Website

# Only needed if the website is hosted somewhere else, such as Netlify.
# Comma-separated, for example: https://www.example.com
CLIENT_ORIGINS=

# Number of proxies in front of this server. Used to rate limit by real visitor address.
TRUST_PROXY=1
